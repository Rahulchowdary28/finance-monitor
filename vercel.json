{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/reminder",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/broadcast",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/daily-summary",
      "schedule": "0 0 * * *"
    }
  ]
}
